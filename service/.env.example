# Copy to .env and edit locally. Never commit actual API keys.
# Base URL only; /chat/completions is added by the gateway.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
# json_object (default), json_schema (provider must support it), or off
LLM_RESPONSE_FORMAT=json_object
# Some newer OpenAI models require max_completion_tokens. Other providers may need off.
LLM_TOKEN_LIMIT_PARAMETER=max_tokens
LLM_MAX_OUTPUT_TOKENS=600
LLM_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=900
CACHE_MAX_ENTRIES=256
MAX_INFLIGHT=4
LOG_DIR=logs
